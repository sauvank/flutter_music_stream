<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="MusicStream" Language="1036" Version="$(var.AppVersion)" Manufacturer="sauvank" UpgradeCode="3F9D6A18-52B7-4C0E-8A41-D7E5B2C9A064">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de MusicStream est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="windows\runner\resources\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Feature Id="ProductFeature" Title="MusicStream" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MusicStream" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="MusicStream"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="6A1D4E27-9B3C-4F58-A0E2-1C7B5D8F3A90">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="MusicStream"
                  Description="Lecteur de musique"
                  Target="[INSTALLFOLDER]MusicStream.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\MusicStream" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="E4C8B1A5-7D26-4093-B5F1-2A9E6C0D8B37">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="MusicStream"
                  Description="Lecteur de musique"
                  Target="[INSTALLFOLDER]MusicStream.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"/>
        <RegistryValue Root="HKCU" Key="Software\MusicStream" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
  </Product>
</Wix>
