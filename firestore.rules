rules_version = '2';

// Each account owns one document holding its encrypted sync envelope.
// The server never sees the data in clear: it only stores ciphertext.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['envelope', 'revision', 'updatedAt'])
        && request.resource.data.revision is int
        && request.resource.data.envelope is map
        // An encrypted library stays far below Firestore's 1 MiB limit.
        && request.resource.size() < 900 * 1024;
    }
    // A computer waiting for a phone to approve sign-in and optionally deliver
    // its sync key. The QR carries a random document id and a separate one-time
    // AES key; Firestore receives only the wrapped sync key.
    match /pairings/{id} {
      allow get: if id.size() >= 32;
      allow create: if request.auth != null
        && id.size() >= 32
        && request.resource.data.keys().hasOnly(['idToken', 'expiresAt', 'wrappedKey'])
        && request.resource.data.idToken is string
        && request.resource.data.idToken.size() < 4096
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(15, 'm')
        && (!('wrappedKey' in request.resource.data)
          || request.resource.data.wrappedKey is map);
      allow delete: if id.size() >= 32;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
