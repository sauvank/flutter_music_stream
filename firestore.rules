rules_version = '2';

// Each account owns one document holding its encrypted sync envelope.
// The server never sees the data in clear: it only stores ciphertext.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['envelope', 'revision', 'updatedAt'])
        && request.resource.data.revision is int
        && request.resource.data.envelope is map
        // An encrypted library stays far below Firestore's 1 MiB limit.
        && request.resource.size() < 900 * 1024;
    }
    // A computer waiting for a phone to approve its sign-in. The 128-bit id is
    // only in the QR code, so a document can be read (never listed) by its
    // holder; it carries a short-lived Google ID token and is deleted after use
    // or on cancel; the token itself expires after an hour anyway.
    match /pairings/{id} {
      allow get: if id.size() >= 32;
      allow create: if request.auth != null
        && id.size() >= 32
        && request.resource.data.keys().hasOnly(['idToken', 'expiresAt'])
        && request.resource.data.idToken is string
        && request.resource.data.idToken.size() < 4096
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(15, 'm');
      allow delete: if id.size() >= 32;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
